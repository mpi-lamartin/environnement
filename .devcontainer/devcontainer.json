{
  "name": "MPI",
  "image": "ghcr.io/mpi-lamartin/environnement:latest",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ocamllabs.ocaml-platform",
        "ms-vscode.cpptools-extension-pack"
      ],
      "settings": {
        "workbench.colorTheme": "Default High Contrast",
        "ocaml.sandbox": {
          "kind": "global"
        }
      }
    }
  }
}
